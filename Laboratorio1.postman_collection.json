    {
      "name": "05 CORS",
      "item": [
        {
          "name": "Comprobar CORS",
          "request": {
            "method": "OPTIONS",
            "url": "http://localhost:8080/api/productos",
            "description": "",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:4200",
                "type": "text"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST",
                "type": "text"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"CORS permite el origen, método y encabezados configurados\", function () {",
                  "  pm.response.to.have.status(200);",
                  "",
                  "  pm.expect(",
                  "    pm.response.headers.get(\"Access-Control-Allow-Origin\")",
                  "  ).to.eql(\"http://localhost:4200\");",
                  "",
                  "  pm.expect(",
                  "    pm.response.headers.get(\"Access-Control-Allow-Methods\") || \"\"",
                  "  ).to.include(\"POST\");",
                  "",
                  "  const encabezados = (",
                  "    pm.response.headers.get(\"Access-Control-Allow-Headers\") || \"\"",
                  "  ).toLowerCase();",
                  "",
                  "  pm.expect(encabezados).to.include(\"authorization\");",
                  "  pm.expect(encabezados).to.include(\"content-type\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
