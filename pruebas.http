### La categoría con productos no se elimina
DELETE {{base}}/categorias/{{labCatId}}
Authorization: Bearer {{labAdmin}}

> {%
    client.test("Categoría relacionada: 409", () => {
        client.assert(response.status === 409);
    });
%}

### El producto sigue intacto después de los rechazos
GET {{base}}/productos/{{labProdId}}
Authorization: Bearer {{labAdmin}}

> {%
    client.test("Los errores no modifican el producto", () => {
        client.assert(response.status === 200);
        client.assert(response.body.nombre === "Producto editado " + client.global.get("labRun"));
        client.assert(Number(response.body.precio) === 1500.75 && response.body.cantidadStock === 11);
        client.assert(Number(response.body.categoriaId) === Number(client.global.get("labCatId")));
    });
%}

### Precio y stock cero son válidos
PUT {{base}}/productos/{{labProdId}}
Authorization: Bearer {{labAdmin}}
Content-Type: application/json

{"nombre":"Producto {{labRun}}","descripcion":"Prueba con valores cero","precio":0,"cantidadStock":0,"categoriaId":{{labCatId}}}

> {%
    client.test("Precio y stock cero permitidos", () => {
        client.assert(response.status === 200);
        client.assert(Number(response.body.precio) === 0 && response.body.cantidadStock === 0);
    });
%}

### 24 - Eliminar producto propio
< {%
    for (let i = 1; i <= 23; i++) if (client.global.get("labCheck" + i) !== "ok") throw new Error("Fallo previo: " + i);
    if (!/^[1-9]\d*$/.test(client.global.get("labProdId"))) throw new Error("ID de producto inválido");
%}
DELETE {{base}}/productos/{{labProdId}}
Authorization: Bearer {{labAdmin}}

> {%
    client.test("Eliminar producto propio", () => {
        client.assert(response.status === 204, "Estado recibido: " + response.status);
        client.global.set("labCheck24", "ok");
    });
%}

### 25 - Producto eliminado
GET {{base}}/productos/{{labProdId}}
Authorization: Bearer {{labAdmin}}

> {%
    client.test("Producto eliminado", () => {
        client.assert(response.status === 404, "Estado recibido: " + response.status);
        client.global.set("labCheck25", "ok");
    });
%}

### 26 - Eliminar categoría propia
< {%
    for (let i = 1; i <= 25; i++) if (client.global.get("labCheck" + i) !== "ok") throw new Error("Fallo previo: " + i);
    if (!/^[1-9]\d*$/.test(client.global.get("labCatId"))) throw new Error("ID de categoría inválido");
%}
DELETE {{base}}/categorias/{{labCatId}}
Authorization: Bearer {{labAdmin}}

> {%
    client.test("Eliminar categoría propia", () => {
        client.assert(response.status === 204, "Estado recibido: " + response.status);
        client.global.set("labCheck26", "ok");
    });
%}

### 27 - Categoría eliminada y suite completa
GET {{base}}/categorias/{{labCatId}}
Authorization: Bearer {{labAdmin}}

> {%
    client.test("Categoría eliminada y suite completa", () => {
        client.assert(response.status === 404, "Estado recibido: " + response.status);
        for (let i = 1; i <= 26; i++) if (client.global.get("labCheck" + i) !== "ok") throw new Error("Fallo previo: " + i);
        client.log("Cuenta de prueba conservada: " + client.global.get("labNewUser"));
        client.global.set("labCheck27", "ok");
    });
%}
