### 20 - Nueva cuenta lee categoría actualizada
GET {{base}}/categorias/{{labCatId}}
Authorization: Bearer {{labNewToken}}

> {%
    client.test("Nueva cuenta lee categoría actualizada", () => {
        client.assert(response.status === 200, "Estado recibido: " + response.status);
        client.assert(response.body.nombre === "Categoria editada " + client.global.get("labRun"));
        client.assert(response.body.descripcion === "Descripcion actualizada");
        client.global.set("labCheck20", "ok");
    });
%}

### 21 - Nueva cuenta lee producto actualizado
GET {{base}}/productos/{{labProdId}}
Authorization: Bearer {{labNewToken}}

> {%
    client.test("Nueva cuenta lee producto actualizado", () => {
        client.assert(response.status === 200, "Estado recibido: " + response.status);
        client.assert(response.body.nombre === "Producto editado " + client.global.get("labRun"));
        client.assert(response.body.descripcion === "Producto actualizado");
        client.assert(Number(response.body.precio) === 1500.75 && response.body.cantidadStock === 11);
        client.assert(Number(response.body.categoriaId) === Number(client.global.get("labCatId")));
        client.global.set("labCheck21", "ok");
    });
%}

