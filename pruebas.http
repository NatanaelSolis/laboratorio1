# Pruebas locales. Ejecutar Run All Requests con Java y Docker iniciados.
# Crea datos propios y conserva una cuenta de prueba para inspección.
@base = http://localhost:8080/api

### 01 - Consulta sin sesión
< {%
    for (let i = 1; i <= 27; i++) client.global.clear("labCheck" + i);
    ["labAdmin", "labUser", "labNewToken", "labCatId", "labProdId"].forEach(k => client.global.clear(k));
    client.global.set("labRun", Date.now() + "_" + Math.floor(Math.random() * 10000));
    client.global.set("labNewUser", "prueba_" + client.global.get("labRun"));
%}
GET {{base}}/productos

> {%
    client.test("Consulta sin sesión", () => {
        client.assert(response.status === 401, "Estado recibido: " + response.status);
        client.global.set("labCheck1", "ok");
    });
%}

### 02 - Login administrador
POST {{base}}/v1/auth/login
Content-Type: application/json

{"username":"admin","password":"AdminLab123!"}

> {%
    client.test("Login administrador", () => {
        client.assert(response.status === 200, "Estado recibido: " + response.status);
        client.assert(!!response.body.access_token);
        client.global.set("labAdmin", response.body.access_token);
        client.global.set("labCheck2", "ok");
    });
%}

### 03 - Login usuario
POST {{base}}/v1/auth/login
Content-Type: application/json

{"username":"usuario","password":"UsuarioLab123!"}

> {%
    client.test("Login usuario", () => {
        client.assert(response.status === 200, "Estado recibido: " + response.status);
        client.assert(!!response.body.access_token);
        client.global.set("labUser", response.body.access_token);
        client.global.set("labCheck3", "ok");
    });
%}

### 04 - Crear categoría
POST {{base}}/categorias
Authorization: Bearer {{labAdmin}}
Content-Type: application/json

{"nombre":"Categoria {{labRun}}","descripcion":"Categoria de prueba"}

> {%
    client.test("Crear categoría", () => {
        client.assert(response.status === 201, "Estado recibido: " + response.status);
        client.assert(Number.isSafeInteger(response.body.id) && response.body.id > 0);
        client.global.set("labCatId", String(response.body.id));
        client.global.set("labCheck4", "ok");
    });
%}

### 05 - Crear producto
POST {{base}}/productos
Authorization: Bearer {{labAdmin}}
Content-Type: application/json

{"nombre":"Producto {{labRun}}","descripcion":"Producto de prueba","precio":1200.50,"cantidadStock":7,"categoriaId":{{labCatId}}}

> {%
    client.test("Crear producto", () => {
        client.assert(response.status === 201, "Estado recibido: " + response.status);
        client.assert(Number.isSafeInteger(response.body.id) && response.body.id > 0);
        client.assert(Number(response.body.categoriaId) === Number(client.global.get("labCatId")));
        client.global.set("labProdId", String(response.body.id));
        client.global.set("labCheck5", "ok");
    });
%}

### 06 - USER consulta categoría
GET {{base}}/categorias/{{labCatId}}
Authorization: Bearer {{labUser}}

> {%
    client.test("USER consulta categoría", () => {
        client.assert(response.status === 200, "Estado recibido: " + response.status);
        client.assert(response.body.nombre === "Categoria " + client.global.get("labRun"));
        client.assert(response.body.descripcion === "Categoria de prueba");
        client.global.set("labCheck6", "ok");
    });
%}

### 07 - USER consulta producto
GET {{base}}/productos/{{labProdId}}
Authorization: Bearer {{labUser}}

> {%
    client.test("USER consulta producto", () => {
        client.assert(response.status === 200, "Estado recibido: " + response.status);
        client.assert(response.body.nombre === "Producto " + client.global.get("labRun"));
        client.assert(response.body.descripcion === "Producto de prueba");
        client.assert(Number(response.body.precio) === 1200.50 && response.body.cantidadStock === 7);
        client.assert(Number(response.body.categoriaId) === Number(client.global.get("labCatId")));
        client.global.set("labCheck7", "ok");
    });
%}

