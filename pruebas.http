### 15 - Administrador consulta usuarios
GET {{base}}/usuarios?first=0&max=100
Authorization: Bearer {{labAdmin}}

> {%
    client.test("Administrador consulta usuarios", () => {
        client.assert(response.status === 200, "Estado recibido: " + response.status);
        client.assert(Array.isArray(response.body) && response.body.length > 0);
        client.assert(response.body.every(u => !!u.id && !!u.username && !("password" in u) && !("credentials" in u)));
        client.global.set("labCheck15", "ok");
    });
%}

### 16 - Actualizar categoría
PUT {{base}}/categorias/{{labCatId}}
Authorization: Bearer {{labAdmin}}
Content-Type: application/json

{"id":{{labCatId}},"nombre":"Categoria editada {{labRun}}","descripcion":"Descripcion actualizada"}

> {%
    client.test("Actualizar categoría", () => {
        client.assert(response.status === 200, "Estado recibido: " + response.status);
        client.assert(response.body.nombre === "Categoria editada " + client.global.get("labRun"));
        client.global.set("labCheck16", "ok");
    });
%}

### 17 - Actualizar producto
PUT {{base}}/productos/{{labProdId}}
Authorization: Bearer {{labAdmin}}
Content-Type: application/json

{"id":{{labProdId}},"nombre":"Producto editado {{labRun}}","descripcion":"Producto actualizado","precio":1500.75,"cantidadStock":11,"categoriaId":{{labCatId}}}

> {%
    client.test("Actualizar producto", () => {
        client.assert(response.status === 200, "Estado recibido: " + response.status);
        client.assert(response.body.nombre === "Producto editado " + client.global.get("labRun"));
        client.assert(Number(response.body.precio) === 1500.75 && response.body.cantidadStock === 11);
        client.global.set("labCheck17", "ok");
    });
%}

